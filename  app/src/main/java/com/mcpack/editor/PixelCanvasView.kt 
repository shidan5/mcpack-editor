package com.mcpack.editor

import android.content.Context
import android.graphics.*
import android.util.AttributeSet
import android.view.MotionEvent
import android.view.View

class PixelCanvasView @JvmOverloads constructor(
    context: Context, attrs: AttributeSet? = null
) : View(context, attrs) {

    private val gridSize = 16
    private var currentColor = Color.BLACK
    private val gridColors = Array(gridSize) { IntArray(gridSize) { Color.TRANSPARENT } }
    private val paint = Paint()

    fun setColor(color: Int) { currentColor = color }

    fun clear() {
        for (i in 0 until gridSize)
            for (j in 0 until gridSize)
                gridColors[i][j] = Color.TRANSPARENT
        invalidate()
    }

    fun getBitmap(): Bitmap {
        val bmp = Bitmap.createBitmap(gridSize, gridSize, Bitmap.Config.ARGB_8888)
        for (i in 0 until gridSize)
            for (j in 0 until gridSize)
                bmp.setPixel(j, i, gridColors[i][j])
        return bmp
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val cellW = width / gridSize.toFloat()
        val cellH = height / gridSize.toFloat()
        for (i in 0 until gridSize) {
            for (j in 0 until gridSize) {
                paint.color = gridColors[i][j]
                canvas.drawRect(j * cellW, i * cellH, (j + 1) * cellW, (i + 1) * cellH, paint)
            }
        }
        paint.color = Color.GRAY
        paint.style = Paint.Style.STROKE
        paint.strokeWidth = 1f
        for (i in 0..gridSize) {
            canvas.drawLine(0f, i * cellH, width.toFloat(), i * cellH, paint)
            canvas.drawLine(i * cellW, 0f, i * cellW, height.toFloat(), paint)
        }
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        val cellW = width / gridSize.toFloat()
        val cellH = height / gridSize.toFloat()
        val col = (event.x / cellW).toInt().coerceIn(0, gridSize - 1)
        val row = (event.y / cellH).toInt().coerceIn(0, gridSize - 1)
        gridColors[row][col] = currentColor
        invalidate()
        return true
    }
}
