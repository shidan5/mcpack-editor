package com.mcpack.editor

import android.os.Bundle
import android.view.View
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import com.mcpack.editor.databinding.ActivityPackBuildBinding
import kotlinx.coroutines.*
import java.io.File

class PackBuildActivity : AppCompatActivity() {

    private lateinit var binding: ActivityPackBuildBinding
    private var lastMcpackFile: File? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityPackBuildBinding.inflate(layoutInflater)
        setContentView(binding.root)

        binding.btnBuild.setOnClickListener {
            binding.progressBar.visibility = View.VISIBLE
            binding.tvStatus.text = "正在打包..."
            binding.btnBuild.isEnabled = false

            CoroutineScope(Dispatchers.IO).launch {
                val outputDir = File(getExternalFilesDir(null), "output")
                outputDir.mkdirs()
                val outputFile = File(outputDir, "MyTexturePack.mcpack")
                val success = PackManager.buildMcpack(this@PackBuildActivity, outputFile.absolutePath)

                withContext(Dispatchers.Main) {
                    binding.progressBar.visibility = View.GONE
                    if (success) {
                        binding.tvStatus.text = "打包成功！文件: ${outputFile.absolutePath}"
                        binding.btnImport.isEnabled = true
                        lastMcpackFile = outputFile
                        Toast.makeText(this@PackBuildActivity, R.string.msg_build_success, Toast.LENGTH_SHORT).show()
                    } else {
                        binding.tvStatus.text = "打包失败，请检查材质包目录"
                        Toast.makeText(this@PackBuildActivity, R.string.msg_build_fail, Toast.LENGTH_SHORT).show()
                    }
                    binding.btnBuild.isEnabled = true
                }
            }
        }

        binding.btnImport.setOnClickListener {
            lastMcpackFile?.let { file ->
                if (file.exists()) {
                    PackManager.importToMinecraft(this, file)
                } else {
                    Toast.makeText(this, "文件不存在，请先打包", Toast.LENGTH_SHORT).show()
                }
            }
        }
    }
}
