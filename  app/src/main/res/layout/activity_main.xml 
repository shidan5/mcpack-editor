<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mc_dark"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MCPE 材质包工作室"
        android:textColor="@color/mc_green"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etPackName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_pack_name"
        android:textColor="@color/mc_text"
        android:textColorHint="@color/mc_text_secondary"
        android:backgroundTint="@color/mc_accent"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etPackDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_pack_desc"
        android:textColor="@color/mc_text"
        android:textColorHint="@color/mc_text_secondary"
        android:backgroundTint="@color/mc_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_select_version"
        android:textColor="@color/mc_text_secondary"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerVersion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/mc_card"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewPack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_new_pack"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditTexture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_edit_texture"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuildPack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_build_pack" />

</LinearLayout>
